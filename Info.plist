<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>walkie</string>
  <key>CFBundleDisplayName</key>
  <string>walkie</string>
  <key>CFBundleIdentifier</key>
  <string>dev.motor.walkie</string>
  <key>CFBundleVersion</key>
  <string>0.1.0</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>

  <!-- No Dock icon. The whole application lives in the menu bar. -->
  <key>LSUIElement</key>
  <true/>

  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>

  <!-- macOS refuses the microphone without this string, and it is what the
       permission prompt shows the user. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>walkie needs the microphone so your contacts can hear you.</string>
</dict>
</plist>
